# ============================================================
# AI Hunter — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Model (litellm format: "provider/model") ---
# Examples:
#   gpt-4o                              (OpenAI)
#   anthropic/claude-3-5-sonnet-20241022 (Anthropic)
#   openrouter/google/gemini-pro        (OpenRouter)
#   groq/llama-3.3-70b-versatile        (Groq)
#   zai/glm-4.7                         (GLM / 智谱 Z.AI)
#   moonshot/moonshot-v1-128k           (Kimi / Moonshot)
#   minimax/MiniMax-M2.1-highspeed      (MiniMax, recommended default)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_REQUESTS_PER_MINUTE=60

# --- Reasoning Model (for ReAct agent decision-making) ---
# Uses stronger reasoning model for tool-use decisions.
# Examples: gpt-4o, anthropic/claude-3-5-sonnet-20241022, openrouter/deepseek/deepseek-r1
REASONING_MODEL=gpt-4o
REASONING_TEMPERATURE=0.2
REASONING_MAX_TOKENS=4096
REASONING_REQUESTS_PER_MINUTE=60

# --- LLM Provider API Keys (fill in the ones you use) ---
# Recommended default:
#   LLM_MODEL=minimax/MiniMax-M2.1-highspeed
#   REASONING_MODEL=minimax/MiniMax-M2.5
# Apply for MiniMax keys in the MiniMax platform dashboard, then paste them here.
# Base URL guidance:
#   International: https://api.minimax.io/v1
#   China mainland: https://api.minimaxi.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_BASE=

# --- Search ---
# Google Maps search: ALWAYS uses Serper (required if you want Maps results)
SERPER_API_KEY=

# General web search: Tavily (primary) → Serper (fallback)
# Tavily supports multiple API keys (comma-separated) for round-robin rotation.
# Strongly recommended for higher-volume hunts: apply for 2-3 keys and join them with commas.
# Example:
#   TAVILY_API_KEY=tvly-dev-xxx,tvly-prod-yyy,tvly-prod-zzz
TAVILY_API_KEY=

JINA_API_KEY=

# --- MCP Search (Tavily + Apify primary flow) ---
# Enable this after filling Tavily and/or Apify credentials in Settings.
# Playwright MCP and Chrome MCP do not require user API keys and are kept as internal/manual browser channels.
MCP_SEARCH_ENABLED=false
MCP_SEARCH_PROVIDER_ORDER=tavily,apify
TAVILY_MCP_DEFAULT_PARAMETERS={"max_results":10,"search_depth":"basic"}
APIFY_TOKEN=
APIFY_MCP_COMMAND=actors-mcp-server
APIFY_MCP_ARGS=
APIFY_MCP_TOOLS=actors,docs,apify/rag-web-browser,apify/facebook-pages-scraper,apify/instagram-scraper,apify/instagram-profile-scraper,apify/facebook-posts-scraper,apify/instagram-post-scraper
APIFY_DEFAULT_ACTOR=apify/rag-web-browser
APIFY_GOOGLE_SEARCH_ACTOR=apify/google-search-scraper
APIFY_GOOGLE_MAPS_ACTOR=lukaskrivka/google-maps-with-contact-details
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_INSTAGRAM_PROFILE_ACTOR=apify/instagram-profile-scraper
APIFY_INSTAGRAM_POST_ACTOR=apify/instagram-post-scraper
APIFY_FACEBOOK_PAGES_ACTOR=apify/facebook-pages-scraper
APIFY_FACEBOOK_ACTOR=apify/facebook-posts-scraper
APIFY_SOCIAL_PREFER_MCP=false
APIFY_SOCIAL_TRANSPORT=http
APIFY_WEB_RAG_ENABLED=false
APIFY_MAX_SOCIAL_QUERIES_PER_TASK=4
APIFY_DATASET_ITEM_LIMIT=20
APIFY_POLL_INTERVAL_SECONDS=3
APIFY_ACTOR_TIMEOUT_SECONDS=120
APIFY_ACTOR_MAX_ITEMS=20
APIFY_ACTOR_MAX_TOTAL_CHARGE_USD=0.2

# --- OpenSearch Evidence Store ---
OPENSEARCH_ENDPOINT=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PREFIX=jps-one
APIFY_TASK_MAX_TOTAL_CHARGE_USD=1.0
SEARCH_SOURCES_DEFAULT=web,google_maps
CANDIDATE_POOL_MULTIPLIER=4

# --- Email ---
# Email generation / campaign / scheduler are available in the current OSS build.
# Recommended:
# - Keep EMAIL_REQUIRE_APPROVAL_BEFORE_SEND=true for safer rollout
# - Test SMTP / IMAP in Settings before enabling auto send / reply detection
EMAIL_FROM_NAME=B2Binsights
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_AUTO_SEND_ENABLED=false
EMAIL_REPLY_DETECTION_ENABLED=false
EMAIL_REQUIRE_APPROVAL_BEFORE_SEND=true
EMAIL_LLM_MODEL=
EMAIL_REASONING_MODEL=
EMAIL_LLM_REQUESTS_PER_MINUTE=0
EMAIL_REASONING_REQUESTS_PER_MINUTE=0

# --- Langfuse (observability, optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=false

# --- Hunt Defaults ---
DEFAULT_TARGET_LEAD_COUNT=200
DEFAULT_MAX_ROUNDS=10
DEFAULT_KEYWORDS_PER_ROUND=8
MIN_NEW_LEADS_THRESHOLD=5

# --- Concurrency ---
SEARCH_CONCURRENCY=10
SCRAPE_CONCURRENCY=5
EMAIL_GEN_CONCURRENCY=3
REACT_MAX_ITERATIONS=5

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
API_ACCESS_TOKEN=
SETTINGS_API_ENABLED=true

# --- Database ---
CHECKPOINT_DB_PATH=hunt_sessions.db
EMAIL_DB_PATH=data/email_automation.db

# --- File Upload ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

AUTOMATION_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AUTOMATION_EMBEDDED_CONSUMER_ENABLED=true
AUTOMATION_TEMPLATE_SEED_PREWARM_ENABLED=true
AUTOMATION_CONSUMER_AUTO_START_CAMPAIGN=true
AUTOMATION_SUMMARY_ENABLED=true
AUTOMATION_SUMMARY_INTERVAL_SECONDS=7200
AUTOMATION_ALERTS_ENABLED=true
AUTOMATION_ALERT_INTERVAL_SECONDS=1800
AUTOMATION_ALERT_BACKLOG_THRESHOLD=20
AUTOMATION_ALERT_FAILED_MESSAGES_THRESHOLD=10
AUTOMATION_EVENT_NOTIFICATIONS_ENABLED=true
AUTOMATION_DISCOVERY_BATCH_SIZE=5
AUTOMATION_SEND_BATCH_SIZE=10
AUTOMATION_EVENT_FLUSH_INTERVAL_SECONDS=600
